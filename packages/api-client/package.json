{
  "name": "@mitay/api-client",
  "version": "0.0.0",
  "private": true,
  "description": "Cliente HTTP tipado generado desde el OpenAPI del backend NestJS. Nunca escribir tipos de DTO a mano.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "openapi-typescript http://localhost:4000/api-json -o src/generated/schema.d.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "@mitay/config": "workspace:*",
    "openapi-typescript": "^7.13.0",
    "typescript": "catalog:"
  }
}
