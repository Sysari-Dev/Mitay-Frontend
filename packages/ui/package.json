{
  "name": "@mitay/ui",
  "version": "0.0.0",
  "private": true,
  "description": "Sistema de diseño de MITAY: tokens Tailwind v4 + componentes genéricos (Atomic Design, base shadcn/ui). Sin lógica de negocio.",
  "type": "module",
  "exports": {
    "./styles.css": "./src/styles/globals.css",
    "./lib/*": "./src/lib/*.ts",
    "./hooks/*": "./src/hooks/*.ts",
    "./atoms/*": "./src/atoms/*.tsx",
    "./molecules/*": "./src/molecules/*.tsx",
    "./organisms/*": "./src/organisms/*.tsx",
    "./templates/*": "./src/templates/*.tsx"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "radix-ui": "^1.8.1"
  },
  "devDependencies": {
    "@mitay/config": "workspace:*",
    "@types/react": "catalog:",
    "react": "catalog:",
    "typescript": "catalog:",
    "next": "catalog:"
  },
  "peerDependencies": {
    "react": "^19",
    "next": "^16"
  }
}
